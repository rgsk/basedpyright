# The parts of torch.nn.Module the sample uses, declared as in torch 2.10.
from collections.abc import Callable
from typing import Any, Self, overload

from torch import Tensor, device, dtype

class Module:
    forward: Callable[..., Any]
    __call__: Callable[..., Any]
    @overload
    def to(self, device: device | str | None = ..., dtype: dtype | None = ..., non_blocking: bool = ...) -> Self: ...
    @overload
    def to(self, dtype: dtype, non_blocking: bool = ...) -> Self: ...
    @overload
    def to(self, tensor: Tensor, non_blocking: bool = ...) -> Self: ...
    def cuda(self, device: int | device | None = None) -> Self: ...
    def cpu(self) -> Self: ...
    def train(self, mode: bool = True) -> Self: ...
    def eval(self) -> Self: ...
    def requires_grad_(self, requires_grad: bool = True) -> Self: ...
    def add_module(self, name: str, module: Module | None) -> None: ...
    def register_module(self, name: str, module: Module | None) -> None: ...

class Linear(Module):
    weight: Tensor
    def __init__(self, in_features: int, out_features: int) -> None: ...
    def forward(self, input: Tensor) -> Tensor: ...

class Embedding(Module):
    weight: Tensor
    def __init__(self, num_embeddings: int, embedding_dim: int) -> None: ...

class ReLU(Module):
    def forward(self, input: Tensor) -> Tensor: ...
