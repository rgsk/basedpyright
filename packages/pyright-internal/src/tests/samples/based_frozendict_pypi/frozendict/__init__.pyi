# A minimal stand-in for the stub of the "frozendict" package on PyPI.
from collections.abc import Hashable, Iterable, Mapping
from typing import Self, TypeVar, overload

_K = TypeVar("_K", bound=Hashable)
_V = TypeVar("_V", covariant=True)
_K2 = TypeVar("_K2", bound=Hashable)
_V2 = TypeVar("_V2")

class frozendict(Mapping[_K, _V]):
    @overload
    def __new__(cls) -> Self: ...
    @overload
    def __new__(cls, **kwargs: _V) -> frozendict[str, _V]: ...
    @overload
    def __new__(cls, mapping: Mapping[_K, _V]) -> Self: ...
    @overload
    def __new__(cls, iterable: Iterable[tuple[_K, _V]]) -> Self: ...
    def copy(self) -> Self: ...
    def __or__(self, other: Mapping[_K2, _V2]) -> frozendict[_K | _K2, _V | _V2]: ...
    def set(self, key: _K2, val: _V2) -> frozendict[_K | _K2, _V | _V2]: ...
    def delete(self, key: _K) -> Self: ...
    def __getitem__(self, key: _K) -> _V: ...
    def __len__(self) -> int: ...
    def __iter__(self): ...
    def __hash__(self) -> int: ...
    @classmethod
    def fromkeys(cls, seq: Iterable[_K], value: _V | None = None) -> Self: ...
